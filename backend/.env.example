# ============================================
# CONFIGURACIÓN BACKEND - BOLIVIAN MARKET
# ============================================

# SERVER
PORT=5000
NODE_ENV=development

# FRONTEND
FRONTEND_URL=http://localhost:5173

# DATABASE (PostgreSQL - Render)
# En producción, Render inyectará DATABASE_URL automáticamente
DATABASE_URL=postgresql://usuario:password@localhost:5432/bolivianmarket_dev

# AUTHENTICATION
JWT_SECRET=tu_super_secreto_jwt_para_desarrollo_cambiar_en_produccion
JWT_EXPIRE=7d

# SUPERADMIN (creado automáticamente)
SUPERADMIN_EMAIL=superadmin@bolivianmarket.com
SUPERADMIN_PASSWORD=superadmin123

# CLOUDINARY (para imágenes - opcional)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# STRIPE (para pagos - opcional)
# STRIPE_SECRET_KEY=sk_test_tu_clave_stripe
# STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_stripe